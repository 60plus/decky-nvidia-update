{
  "name": "decky-nvidia-update",
  "version": "0.4.0",
  "display_name": "NVIDIA Driver Update",
  "description": "Standalone NVIDIA driver preparation for the inactive SteamOS A/B slot, with compressed staging and rollback.",
  "type": "module",
  "scripts": {
    "version": "node -e \"const fs=require('fs');const p='./plugin.json';const o=JSON.parse(fs.readFileSync(p));o.version=process.env.npm_package_version;fs.writeFileSync(p,JSON.stringify(o,null,2)+'\\n');\" && git add plugin.json",
    "build": "node scripts/configure-release.mjs && rollup -c",
    "watch": "node scripts/configure-release.mjs && rollup -c -w",
    "package": "bash package.sh",
    "fix:prettier": "prettier --config .prettierrc --write ./src",
    "check:prettier": "prettier ./src --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moi952/decky-nvidia-update.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steamos",
    "nvidia"
  ],
  "author": "moi952",
  "contributors": ["60plus (SteamOS A/B adaptation)"],
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "4.11.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "prettier": "^3.8.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@moi952/decky-plugin-toolkit": "github:moi952/decky-plugin-toolkit#v0.1.0&path:frontend",
    "@moi952/decky-ui-kit": "^0.6.0",
    "i18next": "^25.8.13",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
